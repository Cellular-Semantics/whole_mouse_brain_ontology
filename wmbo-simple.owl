    <!-- https://purl.brain-bican.org/taxonomy/CCN20230722/class -->

    <owl:NamedIndividual rdf:about="https://purl.brain-bican.org/taxonomy/CCN20230722/class">
        <rdf:type rdf:resource="https://purl.brain-bican.org/taxonomy/Labelset"/>
        <obo:IAO_0000115>The top level of cell type definition in the mouse whole brain taxonomy. It is primarily determined by broad brain region and neurotransmitter type. All cells within a subclass belong to the same class. Class provides a broader categorization of cell types.</obo:IAO_0000115>
        <rdfs:label>class</rdfs:label>
        <taxonomy:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</taxonomy:rank>
    </owl:NamedIndividual>
    


    <!-- https://purl.brain-bican.org/taxonomy/CCN20230722/cluster -->

    <owl:NamedIndividual rdf:about="https://purl.brain-bican.org/taxonomy/CCN20230722/cluster">
        <rdf:type rdf:resource="https://purl.brain-bican.org/taxonomy/Labelset"/>
        <obo:IAO_0000115>The finest level of cell type definition in the mouse whole brain taxonomy. Cells within a cluster share similar characteristics and belong to the same supertype.</obo:IAO_0000115>
        <rdfs:label>cluster</rdfs:label>
        <taxonomy:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</taxonomy:rank>
    </owl:NamedIndividual>
    


    <!-- https://purl.brain-bican.org/taxonomy/CCN20230722/neurotransmitter -->

    <owl:NamedIndividual rdf:about="https://purl.brain-bican.org/taxonomy/CCN20230722/neurotransmitter">
        <rdf:type rdf:resource="https://purl.brain-bican.org/taxonomy/Labelset"/>
        <obo:IAO_0000115>Clusters are assigned based on the average expression of both neurotransmitter transporter genes and key neurotransmitter synthesizing enzyme genes.</obo:IAO_0000115>
        <rdfs:label>neurotransmitter</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- https://purl.brain-bican.org/taxonomy/CCN20230722/subclass -->

    <owl:NamedIndividual rdf:about="https://purl.brain-bican.org/taxonomy/CCN20230722/subclass">
        <rdf:type rdf:resource="https://purl.brain-bican.org/taxonomy/Labelset"/>
        <obo:IAO_0000115>The coarse level of cell type definition in the mouse whole brain taxonomy. All cells within a supertype belong to the same subclass. Subclass groups together related supertypes.</obo:IAO_0000115>
        <rdfs:label>subclass</rdfs:label>
        <taxonomy:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2</taxonomy:rank>
    </owl:NamedIndividual>
    


    <!-- https://purl.brain-bican.org/taxonomy/CCN20230722/supertype -->

    <owl:NamedIndividual rdf:about="https://purl.brain-bican.org/taxonomy/CCN20230722/supertype">
        <rdf:type rdf:resource="https://purl.brain-bican.org/taxonomy/Labelset"/>
        <obo:IAO_0000115>The second finest level of cell type definition in the mouse whole brain taxonomy. All cells within a cluster belong to the same supertype. Supertype groups together similar clusters.</obo:IAO_0000115>
        <rdfs:label>supertype</rdfs:label>
        <taxonomy:rank rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1</taxonomy:rank>
    </owl:NamedIndividual>
</rdf:RDF>



