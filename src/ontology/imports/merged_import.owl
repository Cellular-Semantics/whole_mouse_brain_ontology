# Class: <http://purl.obolibrary.org/obo/GO_0021587> (cerebellum morphogenesis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cls") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dgh") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:jid") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000021") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0838580343") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0021587> "The process in which the anatomical structure of the cerebellum is generated and organized. The cerebellum is the portion of the brain in the back of the head between the cerebrum and the pons. The cerebellum controls balance for walking and standing, modulates the force and range of movement and is involved in the learning of motor skills.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021587> "cerebellum morphogenesis")
