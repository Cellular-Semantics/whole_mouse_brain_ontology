AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0010008> "cardiac endothelial cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_0010008> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000115> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000948>)))
