AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FBbt:00005070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://en.wikipedia.org/wiki/Smooth_muscle") Annotation(rdfs:comment "PMID:8720463") rdfs:comment <http://purl.obolibrary.org/obo/UBERON_8600004> "It is quite common to refer to visceral muscles as smooth muscles, by analogy with vertebrates; however, most visceral muscles in arthropods are actually striated.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_8600004> "visceral muscle tissue")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#prefLabel> <http://purl.obolibrary.org/obo/UBERON_8600004> "visceral muscle tissue")
