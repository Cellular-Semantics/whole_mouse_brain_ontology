AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "BIRNLEX:708") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Thalamus") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0001900> "subthalamus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO:0021539") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "MA:0000181") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0001900> "ventral thalamus")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0001900> "Some sources treat the subthalamus as distinct from the thalamus, separated by the zona limitans intrathalamica. In MA, the ventral thalamus is part of the thalamus. Butler Hodos who identify a dorsal to ventral sequence consisting of epithalamus, dorsal thalamus, ventral thalamus and hypothalamus. We solve this by considering dorsal and ventral thalamus distinct, and the label thalamus as being ambiguous w.r.t thalamus proper (dorsal thalamus) or wider thalamus (dorsal plus ventral)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0001900> "ventral thalamus")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#prefLabel> <http://purl.obolibrary.org/obo/UBERON_0001900> "ventral thalamus")
