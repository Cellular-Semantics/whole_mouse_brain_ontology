AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1101/2020.10.19.343129") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070033> "A physical quality inhering in a neuron by virtue of the relative location of its soma and the regions to which it projects and makes synaptic contacts in.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070033> "neuron projection quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070033> <http://purl.obolibrary.org/obo/PATO_0001018>)

