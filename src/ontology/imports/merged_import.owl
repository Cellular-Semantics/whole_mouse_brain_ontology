AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021561> "facial nerve development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0021561> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0001647>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021561> <http://purl.obolibrary.org/obo/GO_0021545>)
