SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070018> <http://purl.obolibrary.org/obo/PATO_0070017>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070019> (untufted pyramidal morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30715238") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070019> "A pyramidal cell morphology that inheres in neurons which lack a clear tuft formation but extend to large radial distances.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070019> "ilxtr:UntuftedPyramidalPhenotype")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070019> "untufted pyramidal morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070019> <http://purl.obolibrary.org/obo/PATO_0070017>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070020> (stellate pyramidal morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30715238") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070020> "A pyramidal cell morphology that inheres in neurons which lack a tuft formation but extend to small radial distances forming a star-like shape.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070020> "ilxtr:StarPyramidalPhenotype")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070020> "stellate pyramidal morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070020> <http://purl.obolibrary.org/obo/PATO_0070017>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070021> (inverted pyramidal morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30715238") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070021> "A pyramidal cell morphology that inheres in neurons which have an apical tree which is oriented towards the white matter.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070021> "ilxtr:InvertedPyramidalPhenotype")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070021> "inverted pyramidal morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070021> <http://purl.obolibrary.org/obo/PATO_0070017>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070025> (unipolar neuron morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "WikipediaVersioned:Unipolar_neuron&oldid=994458581") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070025> "A cell morphology that inheres in neurons with only one process, a neurite, that extends from the cell body. The neurite then branches to form dendritic and axonal processes.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070025> "unipolar neuron morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070025> <http://purl.obolibrary.org/obo/PATO_0010006>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070026> (multipolar neuron morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "WikipediaVersioned:Multipolar_neuron&oldid=1022942606") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070026> "A cell morphology that inheres in neurons which possess three or more neurites, usually a single axon and many dendrites and dendritic branches.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070026> "ILX:0107196")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070026> "NLX:378")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070026> "multipolar neuron morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070026> <http://purl.obolibrary.org/obo/PATO_0010006>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070027> (bitufted dendrite cell morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18568015") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070027> "A cell morphology that inheres in neurons with dendrites that are bidirectional, emerging from opposite ends of the soma, with the two arbors extending in radial or tangential directions.")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PATO_0070027> "This morphology type is distinct from bitufted cell morphology in that it refers to bitufted dendrite morphology rather than bitufted cell morphology.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070027> "bitufted dendrite cell morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070027> <http://purl.obolibrary.org/obo/PATO_0010006>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070028> (extratelencephalic projecting)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1101/2020.10.19.343129") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070028> "A neuron projection quality that is a characteristic of neurons whose soma is located in the telencephalon and that project to structures outside the telencephalon")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070028> "ILX:0770101")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0070028> "ET projecting")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070028> "extratelencephalic projecting")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070028> <http://purl.obolibrary.org/obo/PATO_0070033>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070030> (near projecting)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DOI:10.1101/2020.10.19.343129") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070030> "A neuron projection quality that is a characteristic of neurons with projections that terminate locally rather than distantly.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070030> "ILX:0770103")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0070030> "NP")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070030> "near projecting")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070030> <http://purl.obolibrary.org/obo/PATO_0070033>)

