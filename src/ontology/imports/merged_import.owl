AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070017> "ilxtr:PyramidalPhenotype")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0070017> "pyramidal cell morphology")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0070017> "vertical pyramidal morphology")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070017> "standard pyramidal morphology")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070017> <http://purl.obolibrary.org/obo/PATO_0070015>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070018> (tufted pyramidal morphology)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30715238") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070018> "A pyramidal cell morphology that inheres in neurons which have a distinct tuft formation, distal from the soma.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070018> "ilxtr:TuftedPyramidalPhenotype")
