AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021553> "olfactory nerve development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0021553> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0001579>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021553> <http://purl.obolibrary.org/obo/GO_0021545>)
