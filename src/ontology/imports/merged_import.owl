AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0007616> "layer of synovial tissue")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0007616> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0000042> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0003000> <http://purl.obolibrary.org/obo/UBERON_0001090>)))
