# Class: <http://purl.obolibrary.org/obo/GO_0009790> (embryo development)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:go_curators") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:isa_complete") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_sensu") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0009790> "The process whose specific outcome is the progression of an embryo from its formation until the end of its embryonic life stage. The end of the embryonic stage is organism-specific. For example, for mammals, the process would begin with zygote formation and end with birth. For insects, the process would begin at zygote formation and end with larval hatching. For plant zygotic embryos, this would be from zygote formation to the end of seed dormancy. For plant vegetative embryos, this would be from the initial determination of the cell or group of cells to form an embryo until the point when the embryo becomes independent of the parent plant.")
AnnotationAssertion(Annotation(rdfs:label "Activation of HOX genes during differentiation") <http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0009790> "Reactome:R-HSA-5619507")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0009790> "Wikipedia:Embryogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0009790> "embryogenesis")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/GO_0009790> "embryonal development")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0009790> "embryo development")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0009790> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048856> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0000922>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0009790> <http://purl.obolibrary.org/obo/GO_0007275>)
SubClassOf(<http://purl.obolibrary.org/obo/GO_0009790> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_131567>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0009790> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002296> <http://purl.obolibrary.org/obo/UBERON_0000922>))

