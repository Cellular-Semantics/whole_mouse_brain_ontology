AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:mtg_apoptosis") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12083798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16624291") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Bleb_(cell_biology)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0032059> "A cell extension caused by localized decoupling of the cytoskeleton from the plasma membrane and characterized by rapid formation, rounded shape, and scarcity of organelles within the protrusion. Blebs are formed during apoptosis and other cellular processes, including cell locomotion, cell division, and as a result of physical or chemical stresses.")
