AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/PATO_0070034> "ILX:0770100")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PATO_0070034> "IT projecting")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070034> "intratelencephalic projecting")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070034> <http://purl.obolibrary.org/obo/PATO_0070033>)

# Class: <http://purl.obolibrary.org/obo/PATO_0070044> (anatomical structure quality)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PATO_0070044> "A quality of continuant that exist at the anatomical level of organisation and anything under it. This includes, but is not limited to, cells , tissues, and components.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/PATO_0070044> "anatomical structure quality")
SubClassOf(<http://purl.obolibrary.org/obo/PATO_0070044> <http://purl.obolibrary.org/obo/PATO_0001241>)

