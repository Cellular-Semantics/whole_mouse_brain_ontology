TransitiveObjectProperty(<http://purl.obolibrary.org/obo/RO_0002158>)

# Object Property: <http://purl.obolibrary.org/obo/RO_0002160> (only in taxon)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002160> "x only in taxon y if and only if x is in taxon y, and there is no other organism z such that y!=z a and x is in taxon z.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002160> "only in taxon")
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002160> <http://purl.obolibrary.org/obo/RO_0002162>)

