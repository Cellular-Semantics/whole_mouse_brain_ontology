SubClassOf(<http://purl.obolibrary.org/obo/GO_0021592> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0030902>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021592> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_89593>))
