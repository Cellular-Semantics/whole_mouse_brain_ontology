# Class: <http://purl.obolibrary.org/obo/CL_0000706> (choroid plexus epithelial cell)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:add") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:tfm") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "JB:jb") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15561411") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9550134") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_0000706> "A specialized ependymal cell that is part of the choroid plexus epithelium, responsible for producing cerebrospinal fluid (CSF) by selectively filtering and modifying blood plasma components before secreting it into the brain and spinal cord. This cell is characterized by a brush border on its apical surface, which enhances the secretion of CSF.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/CL_0000706> "FMA:70549")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0000706> "epithelial cell of choroid plexus")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25729351") rdfs:comment <http://purl.obolibrary.org/obo/CL_0000706> "A choroid plexus epithelial cell possesses non-motile 9+0 cilia. While these cilia can exhibit transient motility during development, they generally do not contribute significantly to the directional flow of cerebrospinal fluid (CSF). Instead, they are primarily involved in sensory functions.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000706> "choroid plexus epithelial cell")
