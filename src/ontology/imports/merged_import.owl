# Class: <http://purl.obolibrary.org/obo/CL_4042003> (border associated macrophage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37232741") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37626977") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4042003> "A central nervous system macrophage that is part of a choroid plexus, a meninx and a perivascular space. A border associated macrophage interacts with various components of the CNS vasculature and meninges, it participates in immune surveillance and in the regulation of the blood brain barrier.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29426702") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37232741") rdfs:comment <http://purl.obolibrary.org/obo/CL_4042003> "In humans, a border associate macrophage expresses CD45 and CD11B. This cell is also known to have the following molecular signature: CD206, CD38, LYVE1, CD163, CD169.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4042003> "border associated macrophage"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4042003> <http://purl.obolibrary.org/obo/CL_0000878>)

# Class: <http://purl.obolibrary.org/obo/CL_4042013> (Lamp5 Lhx6 neuron)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34004146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36007006") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37824655") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37824669") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://cellxgene.cziscience.com/e/e4ddac12-f48f-4455-8e8d-c2a48a683437.cxg/") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/CL_4042013> "A transcriptomically distinct lamp5 GABAergic cortical interneuron located in the cerebral cortex that expresses Lamp5 and Lhx6. The standard transcriptomic reference data for this cell type can be found on the CellxGene census under the collection: 'Transcriptomic cytoarchitecture reveals principles of human neocortex organization', dataset: 'Supercluster: CGE-derived interneurons', Author Categories: 'CrossArea_subclass', Lamp5 Lhx6.")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36007006") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4042013> "Ivy cell")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30382198") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_4042013> "Lamp5-Lhx6 type")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.5281/zenodo.11165918") rdfs:comment <http://purl.obolibrary.org/obo/CL_4042013> "The marker set CHST9, LAMP5 can identify the Human cell type Lamp5 Lhx6 neuron in the Brain with a confidence of 0.821678322 (NS-Forest FBeta value).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4042013> "Lamp5 Lhx6 neuron"@en)
SubClassOf(<http://purl.obolibrary.org/obo/CL_4042013> <http://purl.obolibrary.org/obo/CL_4023011>)
