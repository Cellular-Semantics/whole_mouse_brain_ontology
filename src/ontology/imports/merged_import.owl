SubClassOf(<http://purl.obolibrary.org/obo/GO_0042471> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_89593>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0042471> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002298> <http://purl.obolibrary.org/obo/UBERON_0001690>))

# Class: <http://purl.obolibrary.org/obo/GO_0042472> (inner ear morphogenesis)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:jl") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0192801023") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0042472> "The process in which the anatomical structures of the inner ear are generated and organized. The inner ear is the structure in vertebrates that contains the organs of balance and hearing. It consists of soft hollow sensory structures (the membranous labyrinth) containing fluid (endolymph) surrounded by fluid (perilymph) and encased in a bony cavity (the bony labyrinth). It consists of two chambers, the sacculus and utriculus, from which arise the cochlea and semicircular canals respectively.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0042472> "inner ear morphogenesis")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0042472> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0009653> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002298> <http://purl.obolibrary.org/obo/UBERON_0001846>)))
