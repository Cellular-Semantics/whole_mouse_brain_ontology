AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0011027> "skeleton muscle fibroblast")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0011027> "skeletal muscle fibroblast")
