AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "DHBA:10168") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0016634> "premotor cortex (area 6)")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0016634> "premotor cortex")
