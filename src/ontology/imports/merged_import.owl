AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0010262> "operculum of brain")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#prefLabel> <http://purl.obolibrary.org/obo/UBERON_0010262> "operculum of brain")
