ObjectPropertyRange(<http://purl.obolibrary.org/obo/RO_0001025> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000004> ObjectComplementOf(<http://purl.obolibrary.org/obo/BFO_0000006>)))

# Object Property: <http://purl.obolibrary.org/obo/RO_0002000> (2D boundary of)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/RO_0002000> "a relation between a 2D immaterial entity (the boundary) and a material entity, in which the boundary delimits the material entity"@en)
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002000> "2D boundary of"@en)
