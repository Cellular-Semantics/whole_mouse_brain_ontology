AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0010842> "retina layer formation")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0010842> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048646> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002297> <http://purl.obolibrary.org/obo/UBERON_0001781>)))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0010842> <http://purl.obolibrary.org/obo/GO_0048646>)
