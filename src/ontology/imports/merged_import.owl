AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001012> "leukocyte adhesion receptor MO1")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/PR_000001012> "neutrophil adherence receptor")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/PR_000001012> "Category=gene. Requested by=CL.")
