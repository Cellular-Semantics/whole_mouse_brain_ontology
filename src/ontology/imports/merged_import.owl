AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_4033093> "limbal epithelial stem cell of cornea")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_4033093> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0000034> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0006761>)))
