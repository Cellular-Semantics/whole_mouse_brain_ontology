AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "FMA:5923") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0011925> "preganglionic nerve fiber")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0011925> "preganglionic autonomic fiber")
EquivalentClasses(<http://purl.obolibrary.org/obo/UBERON_0011925> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/UBERON_0006134> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/uberon/core#extends_fibers_into> <http://purl.obolibrary.org/obo/UBERON_0001017>) ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/uberon/core#extends_fibers_into> <http://purl.obolibrary.org/obo/UBERON_0001805>)))
