AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0002673> "tongue muscle cell")
EquivalentClasses(<http://purl.obolibrary.org/obo/CL_0002673> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/CL_0008002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0000378>)))
