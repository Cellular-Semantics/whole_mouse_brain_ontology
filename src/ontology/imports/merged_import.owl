# Class: <http://purl.obolibrary.org/obo/UBERON_0014533> (medullary lamina of thalamus)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Medullary_laminae_of_thalamus") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UBERON_0014533> "Medullary laminae of thalamus are layers of myelinated fibres that appear on cross sections of the thalamus. They also are commonly referred to as laminae medullares thalami or medullary layers of thalamus. The specific layers are: Lamina medullaris lateralis (external medullary lamina) - separates ventral and lateral thalamus from the subthalamus and thalamic reticular nucleus; Lamina medullaris medialis (internal medullary lamina) - positioned between the dorsomedial and ventral nuclei of thalamus, encloses the intralaminar nuclei (centromedian nucleus, paracentral, and central lateral).")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0014533> "BAMS:Lam.med.thal")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0014533> "Wikipedia:Medullary_laminae_of_thalamus")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0014533> "medullary lamina of thalamus")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#prefLabel> <http://purl.obolibrary.org/obo/UBERON_0014533> "medullary lamina of thalamus")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0014533> <http://purl.obolibrary.org/obo/UBERON_0014531>)
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0014533> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/UBERON_0010225>))

