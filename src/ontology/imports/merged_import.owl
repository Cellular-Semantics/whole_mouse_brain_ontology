SubClassOf(<http://purl.obolibrary.org/obo/GO_0042472> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0048839>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0042472> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_89593>))
