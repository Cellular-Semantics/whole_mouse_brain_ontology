AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0004117> "Wikipedia:Pharyngeal_pouch_(embryology)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0004117> "XAO:0000282")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/UBERON_0004117> "ZFA:0001106")
AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Branchial_pouch") <http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UBERON_0004117> "branchial pouch")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/UBERON_0004117> "The pouches are polarized structures. For example, whereas the rostral half of each pouch expresses Bmp-7, the caudal half expresses FGF-8 and the dorsal aspect of each pouch is marked via its expression of Pax-1. each pouch has an individual sense of identity. Shh expression is a prominent early feature of the caudal endoderm of the second arch, and individual pouches mark the anterior limits of expression of Hox genes within the pharyngeal endoderm; Hox-a2 has a rostral boundary at the second pouch, Hox-a3 at the third pouch and Hox-a4 at the most caudal pouch[PMID:16313389]")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UBERON_0004117> "pharyngeal pouch")
SubClassOf(<http://purl.obolibrary.org/obo/UBERON_0004117> <http://purl.obolibrary.org/obo/UBERON_0002050>)
