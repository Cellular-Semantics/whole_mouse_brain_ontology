AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/CL_0000127> "astrocytic glia")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/CL_0000127> "Astrocytes are reportedly CD68-negative, CD121a-positive, CD184-positive, CD192-positive, CRF-positive, EGFR-positive, GFAP-positive, GLUT1-positive, MBP-negative, and NGFR-positive.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000127> "astrocyte")
