# Class: <http://purl.obolibrary.org/obo/GO_0021608> (accessory nerve formation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cls") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dgh") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:jid") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000021") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0838580343") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0021608> "The process that gives rise to the accessory nerve. This process pertains to the initial formation of a structure from unspecified parts. The spinal branch of this motor nerve innervates the trapezius and the sternocleidomastoid muscles. The cranial branch joins the vagus nerve and innervates the same targets as the vagus nerve.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021608> "accessory nerve formation")
