# Class: <http://purl.obolibrary.org/obo/GO_0005694> (chromosome)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0198547684") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0005694> "A structure composed of a very long molecule of DNA and associated proteins (e.g. histones) that carries hereditary information.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> <http://purl.obolibrary.org/obo/GO_0005694> "Wikipedia:Chromosome")
AnnotationAssertion(rdfs:comment <http://purl.obolibrary.org/obo/GO_0005694> "Chromosomes include parts that are not part of the chromatin. Examples include the kinetochore.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0005694> "chromosome")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#prefLabel> <http://purl.obolibrary.org/obo/GO_0005694> "chromosome")
