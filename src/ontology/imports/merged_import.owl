SubClassOf(<http://purl.obolibrary.org/obo/GO_0021610> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <http://purl.obolibrary.org/obo/GO_0021561>))
SubClassOf(<http://purl.obolibrary.org/obo/GO_0021610> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002162> <http://purl.obolibrary.org/obo/NCBITaxon_7742>))
