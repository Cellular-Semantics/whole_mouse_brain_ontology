AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17535929") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27215193") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37426070") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1016/j.stem.2023.11.013") rdfs:comment <http://purl.obolibrary.org/obo/CL_0000121> "Neurodegenerative disorders affecting Purkinje cells disrupt motor functions. Some of the neurodegenerative disorders that causes loss and degeration of Purkinje cells are Spinocerebellar ataxias (SCAs) (Josef P Kapfhammer and Etsuko Shimobayashi 2023), Friedreich's ataxia (FRDA) (Kevin C Kemp et al., 2016), Fetal alcohol syndrome (Laurent Servais et al., 2016), Dandy-Walker malformation (Alexander Atamian et al., 2024).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0000121> "Purkinje cell")
