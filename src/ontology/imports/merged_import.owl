AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23649873") rdfs:comment <http://purl.obolibrary.org/obo/CL_0002085> "This class includes cells that are sometimes referred to as tanycyte-like cells,  located in circumventricular organs (Langlet et al., 2023) as well as tanycytes located in the ventricles.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0002085> "tanycyte")
