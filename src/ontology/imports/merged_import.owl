# Class: <http://purl.obolibrary.org/obo/GO_0021705> (locus ceruleus formation)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:cls") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dgh") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:dph") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GOC:jid") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "GO_REF:0000021") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "ISBN:0838580343") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/GO_0021705> "The process that gives rise to the locus ceruleus. This process pertains to the initial formation of a structure from unspecified parts. In mice, the locus ceruleus is a dense cluster of neurons within the dorsorostral pons. This nucleus is the major location of neurons that release norepinephrine throughout the brain, and is responsible for physiological responses to stress and panic.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/GO_0021705> "locus ceruleus formation")
EquivalentClasses(<http://purl.obolibrary.org/obo/GO_0021705> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/GO_0048646> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002297> <http://purl.obolibrary.org/obo/UBERON_0002148>)))
