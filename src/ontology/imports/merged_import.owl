AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/CL_0011012> "neural crest cell")
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#prefLabel> <http://purl.obolibrary.org/obo/CL_0011012> "neural crest cell")
