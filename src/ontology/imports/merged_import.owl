AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/RO_0002002> "has 2D boundary"@en)
SubObjectPropertyOf(<http://purl.obolibrary.org/obo/RO_0002002> <http://purl.obolibrary.org/obo/RO_0002323>)
