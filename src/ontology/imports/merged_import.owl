AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11114424") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PRO:CNA") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:CD8") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/PR_000001084> "A protein that is a translation product of the human CD8A gene or a 1:1 ortholog thereof. CD8 is a transmembrane that is a co-receptor for MHC class-I antigen/T-cell receptor interaction. The most common form of CD8 is composed of a CD8 alpha and a CD8 beta chain.")
